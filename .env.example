# Required for Gemini chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional alternate provider: OpenRouter free-model router
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional: choose an image model supported by your Gemini API project
GEMINI_IMAGE_MODEL=

# Optional: enables real web search in Research
TAVILY_API_KEY=

# Optional: enables Supabase auth and cloud persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, server-only: enables guarded admin tools
ADMIN_EMAIL_ALLOWLIST=
SUPABASE_SERVICE_ROLE_KEY=

# Optional process-local request limits; admin settings can override these
USAGE_LIMIT_FREE=20
USAGE_LIMIT_PRO=500
USAGE_LIMIT_PREMIUM=2500
